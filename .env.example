APP_PORT=3000
API_PORT=3001
API_URL=http://localhost:3001
POSTGRES_PORT=5432
POSTGRES_DB=home_server
POSTGRES_USER=home_server
POSTGRES_PASSWORD=cambia-esta-clave-de-postgres

# Se crea el primer administrador si la base de datos todavía no tiene uno.
# Cámbialos después del primer inicio en un servidor público.
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin1234
# Ruta del disco externo en el host. En Ubuntu usa una ruta absoluta, por ejemplo /mnt/external.
EXTERNAL_DISK_MOUNT=./Download/test
# Secret used only by the API and aria2 RPC bridge.
ARIA2_RPC_SECRET=cambia-este-secreto-largo
ARIA2_RPC_PORT=6800
