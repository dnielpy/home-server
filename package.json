{
  "name": "home-server-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @home-server/contracts build && pnpm --filter @home-server/database build && turbo run dev --ui=tui",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "turbo run db:generate --filter=@home-server/database",
    "db:migrate": "turbo run db:migrate --filter=@home-server/database"
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  },
  "packageManager": "pnpm@11.25.0"
}
